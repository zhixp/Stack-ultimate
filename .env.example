# ---------- Frontend (exposed to the browser; never put secrets here) ----------
VITE_CHAIN=base-sepolia            # base | base-sepolia
VITE_CONTRACT_ADDRESS=             # StackUltimate address after deploying
VITE_PRIVY_APP_ID=                 # from dashboard.privy.io (enable Base / Base Sepolia there)
# VITE_RPC_URL=                    # optional: your own Base RPC (Alchemy, QuickNode, ...)
# VITE_API_URL=                    # only if the server is on another domain

# ---------- Server (secret) ----------
CHAIN=base-sepolia
CONTRACT_ADDRESS=
OPERATOR_PRIVATE_KEY=              # hot wallet that starts games and submits scores; fund it with a little ETH for gas
SESSION_SECRET=                    # 32+ random chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# RPC_URL=                         # recommended in production
# PORT=8787
# TRUST_PROXY=1                    # set when running behind Render / Railway / nginx
# ALLOWED_ORIGINS=                 # only if the frontend is served from another origin
# DATA_DIR=data
